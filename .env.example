# Copiar a `.env` y completar (no commitear `.env`).
# Pooler: runtime Next.js / PrismaClient (`src/lib/prisma.ts`).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Conexión directa: CLI Prisma migraciones (`prisma.config.ts` usa DIRECT_URL si existe).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Sesión / editor (producción obligatorio) ---
SESSION_SECRET="cambia-por-32-bytes-aleatorios-en-prod-OK"
EDITOR_PASSWORD="clave para activar modo editor en UI"

# --- DUX API (lista tienda y compras; producción según entorno) ---
DUX_API_TOKEN=""
DUX_FETCH_TIMEOUT_MS="10000"
DUX_COD_TIENDA="DUX"
DUX_SYNC_DELAY_MS="5000"
# ID lista DUX principal (default 56994) → prod_tienda_precios
DUX_ID_PRECIO_LISTA="56994"
# IDs depósito DUX Maipú / Guaymallén (default 16923 / 4565) → prod_tienda_stock
DUX_ID_STOCK_MAIPU="16923"
DUX_ID_STOCK_GUAYMALLEN="4565"
DUX_COMPRAS_SYNC_LIMIT=""
DUX_COMPRAS_SYNC_MAX_PAGES=""
DUX_COMPRAS_MIN_INTERVAL_MS=""
DUX_ID_EMPRESA_COMPRAS=""
# POST v2/compras — percepción IVA (defaults: id 11705, porc 21)
DUX_ID_PERCEPCION_IVA=""
DUX_PORC_PERCEPCION_IVA=""

# --- Otros ---
COTIZACION_DOLAR="1"
WHATSAPP_API_TOKEN=""
